# Copy to .env and fill in.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# "openrouter" for real generation, "fixture" for offline/dev play (no key needed)
LLM_BACKEND=openrouter

DB_PATH=dcc.sqlite3

# Optional: override the three model tiers (defaults live in app/config.py)
# PARSER_MODEL=...
# GEN_MODEL=...
# IMAGE_MODEL=...

# Sent to OpenRouter as HTTP-Referer / X-Title (app attribution, optional)
APP_URL=https://github.com/lungdart/token-crawl
APP_TITLE=Token Crawl
